  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=130%><color=#FFD84D>GCFire Studios</color></size>\r\n\r\n<i>Um jogo
    desenvolvido para o</i>\r\n<color=#FFD84D>FIAP 2026 Challenge</color>\r\nem parceria
    com a <color=#FFD84D>Arcos Dorados</color>\r\n<i>Projeto finalista, Top 3</i>\r\n\r\n\r\n\r\n<size=115%><color=#FFD84D>-
    EQUIPE -</color></size>\r\n\r\n<color=#FFD84D>Pedro Rodrigues Chacon</color>\r\nPrograma\xE7\xE3o
    e Game Design\r\n<size=70%>linkedin.com/in/pedro-chacon-</size>\r\n\r\n<color=#FFD84D>Eduardo
    Costa de Melo</color>\r\nModelagem e Texturiza\xE7\xE3o\r\n<size=70%>linkedin.com/in/eduardo-costa-de-melo-b9729a33a</size>\r\n\r\n<color=#FFD84D>Geniel
    Henrique Martins Xavier</color>\r\nPrograma\xE7\xE3o e Arte de UI\r\n<size=70%>linkedin.com/in/genielhenrique</size>\r\n\r\n\r\n\r\n<size=115%><color=#FFD84D>-
    \xC1UDIO -</color></size>\r\n\r\n\xC1udio implementado com <color=#FFD84D>FMOD
    Studio</color>\r\nFMOD Studio by Firelight Technologies Pty Ltd.\r\n\r\n<color=#FFD84D>M\xFAsicas</color>\r\n\r\n\"Cool
    Vibes\"\r\n\"Vibing Over Venus\"\r\n\"Crinoline Dreams\"\r\nKevin MacLeod (incompetech.com)\r\nLicenciadas
    sob Creative Commons: By Attribution 4.0\r\n<size=70%>http://creativecommons.org/licenses/by/4.0/</size>\r\n\r\n\r\n\r\n<size=115%><color=#FFD84D>-
    MODELOS 3D -</color></size>\r\n\r\nPersonagens dos clientes (NPCs), via Sketchfab:\r\n\r\n<size=60%>1.
    https://sketchfab.com/3d-models/anime-charactersouta-free-unity-3d-fa79710a9b7b4bf79fe4bf63edd8cfd8\r\n2.
    https://sketchfab.com/3d-models/anime-characterarisa-free-unity-3d-284317925844496994d76ef4ea6024b6\r\n3.
    https://sketchfab.com/3d-models/anime-style-character-78802e50dfe6492192a4d2365a500ff3</size>\r\n\r\n\r\n\r\n<size=115%><color=#FFD84D>-
    AGRADECIMENTOS -</color></size>\r\n\r\nObrigado \xE0 <color=#FFD84D>Arcos Dorados</color>
    e \xE0 <color=#FFD84D>FIAP</color> pela oportunidade\r\ne por um desafio que
    nos fez crescer muito como equipe.\r\nFoi um projeto feito com muito esfor\xE7o
    e carinho e chegar ao Top 3 foi a melhor recompensa.\r\n\r\nE obrigado a voc\xEA
    por jogar. Boa sorte no pr\xF3ximo turno!\r\n\r\n<size=70%>\xA9 2026 GCFire Studios</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
